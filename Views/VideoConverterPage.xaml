<UserControl
    x:Name="Root"
    x:Class="SuperMediaSuites.Views.VideoConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SuperMediaSuites.Views"
    xmlns:models="using:SuperMediaSuites.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="760" d:DesignWidth="940"
    FontFamily="Segoe UI Semibold">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E94560" Opacity="0.5"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E94560" Opacity="0.55"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <!-- Per-tab accent: Video (pink-red) -->
        <Color x:Key="SystemAccentColor">#E94560</Color>
        <Color x:Key="SystemAccentColorLight1">#E94560</Color>
        <Color x:Key="SystemAccentColorLight2">#E94560</Color>
        <Color x:Key="SystemAccentColorLight3">#E94560</Color>
        <Color x:Key="SystemAccentColorDark1">#C62F4A</Color>
        <Color x:Key="SystemAccentColorDark2">#A6263F</Color>
        <Color x:Key="SystemAccentColorDark3">#861D33</Color>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Padding="28,20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Video Converter" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="mp4 · mkv · mov · avi · webm · wmv · flv" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="18">
                <TextBlock Text="Drag &amp; drop video files here, or use Add files" Opacity="0.55"/>
            </Border>
            <Button Grid.Column="1" Content="Add files" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddFilesCommand}"/>
            <Button Grid.Column="2" Content="Clear" Command="{x:Bind ViewModel.ClearAllCommand}"/>
        </Grid>

        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="6" Padding="6">
            <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConversionItem">
                        <Grid ColumnSpacing="10" Padding="6" AutomationProperties.Name="{x:Bind FileName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Opacity="0.65" FontSize="12"/>
                            </StackPanel>
                            <ProgressBar Grid.Column="1" Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" VerticalAlignment="Center"
                                    Click="OnRemoveItemClick"
                                    Content="✕" Padding="8,4"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16" Padding="0,4">
            <StackPanel Spacing="2">
                <TextBlock Text="Output format" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.OutputFormats, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.TargetFormat, Mode=TwoWay}" MinWidth="120"/>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="Resolution" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.Resolutions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.ResolutionPreset, Mode=TwoWay}" MinWidth="120"/>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="Quality (CRF): lower = better" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Slider Minimum="0" Maximum="51" Value="{x:Bind ViewModel.Crf, Mode=TwoWay}" Width="180"/>
                    <TextBlock Text="{x:Bind ViewModel.Crf, Mode=OneWay}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Content="Convert" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ConvertCommand}" IsEnabled="{x:Bind ViewModel.CanConvert, Mode=OneWay}"/>
                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
                <Button Content="Output folder…" Command="{x:Bind ViewModel.ChooseOutputFolderCommand}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}" Opacity="0.55" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>

        <StackPanel Grid.Row="6" Spacing="4">
            <ProgressBar Value="{x:Bind ViewModel.Status.Progress, Mode=OneWay}" Maximum="100"/>
            <TextBlock Text="{x:Bind ViewModel.Status.StatusMessage, Mode=OneWay}" Opacity="0.7" FontSize="12"/>
        </StackPanel>

        <TextBlock Grid.Row="7" Text="{x:Bind ViewModel.FooterNote, Mode=OneWay}" Opacity="0.45" FontSize="12"/>
    </Grid>
</UserControl>
