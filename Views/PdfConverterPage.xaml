<UserControl
    x:Name="Root"
    x:Class="SuperMediaSuites.Views.PdfConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SuperMediaSuites.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="940"
    FontFamily="Georgia">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#F2994A" Opacity="0.55"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#F2994A" Opacity="0.6"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <!-- Per-tab accent: PDF (orange) -->
        <Color x:Key="SystemAccentColor">#F2994A</Color>
        <Color x:Key="SystemAccentColorLight1">#F2994A</Color>
        <Color x:Key="SystemAccentColorLight2">#F2994A</Color>
        <Color x:Key="SystemAccentColorLight3">#F2994A</Color>
        <Color x:Key="SystemAccentColorDark1">#D97F31</Color>
        <Color x:Key="SystemAccentColorDark2">#B86927</Color>
        <Color x:Key="SystemAccentColorDark3">#94531F</Color>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Padding="28,20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="PDF Converter" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="PDF ↔ Images · Merge · Split" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <RadioButtons MaxColumns="4" SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                <x:String>PDF → Images</x:String>
                <x:String>Images → PDF</x:String>
                <x:String>Merge PDFs</x:String>
                <x:String>Split PDF</x:String>
            </RadioButtons>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="18">
                <TextBlock Text="Drag &amp; drop files here, or use Add files" Opacity="0.55"/>
            </Border>
            <Button Grid.Column="1" Content="Add files" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddFilesCommand}"/>
            <Button Grid.Column="2" Content="Clear" Command="{x:Bind ViewModel.ClearAllCommand}"/>
        </Grid>

        <Border Grid.Row="4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="6" Padding="6">
            <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConversionItem">
                        <Grid ColumnSpacing="10" Padding="6" AutomationProperties.Name="{x:Bind FileName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Opacity="0.65" FontSize="12"/>
                            </StackPanel>
                            <ProgressBar Grid.Column="1" Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" VerticalAlignment="Center"
                                    Click="OnRemoveItemClick"
                                    Content="✕" Padding="8,4"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Mode A options: PDF → Images -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="16" Visibility="{x:Bind ViewModel.IsModeA, Mode=OneWay}">
            <StackPanel Spacing="2">
                <TextBlock Text="Image format" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.ImageFormats, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.ImageFormat, Mode=TwoWay}" MinWidth="120"/>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="DPI" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableDpis, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Dpi, Mode=TwoWay}" MinWidth="100"/>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="Pages (e.g. 1-3,5)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <TextBox Text="{x:Bind ViewModel.PageRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140" PlaceholderText="all"/>
            </StackPanel>
        </StackPanel>

        <!-- Mode B options: Images → PDF -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="16" Visibility="{x:Bind ViewModel.IsModeB, Mode=OneWay}">
            <StackPanel Spacing="2">
                <TextBlock Text="Page size" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.PageSizes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.PageSize, Mode=TwoWay}" MinWidth="110"/>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="Orientation" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.Orientations, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Orientation, Mode=TwoWay}" MinWidth="110"/>
            </StackPanel>
            <CheckBox Content="Compress" IsChecked="{x:Bind ViewModel.Compress, Mode=TwoWay}" VerticalAlignment="Bottom"/>
            <StackPanel Spacing="2">
                <TextBlock Text="Password (optional)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <TextBox Text="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
            </StackPanel>
        </StackPanel>

        <!-- Split options -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="16" Visibility="{x:Bind ViewModel.IsSplit, Mode=OneWay}">
            <StackPanel Spacing="2">
                <TextBlock Text="Pages to extract (e.g. 1-3,5,8-10)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <TextBox Text="{x:Bind ViewModel.PageRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" PlaceholderText="1-"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Content="Convert pages" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind ViewModel.IsModeA, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ConvertCommand}" IsEnabled="{x:Bind ViewModel.CanConvert, Mode=OneWay}"/>
                <Button Content="Create PDF" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind ViewModel.IsModeB, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ImagesToPdfCommand}" IsEnabled="{x:Bind ViewModel.HasAnyItems, Mode=OneWay}"/>
                <Button Content="Merge PDFs" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind ViewModel.IsMerge, Mode=OneWay}"
                        Command="{x:Bind ViewModel.MergePdfsCommand}" IsEnabled="{x:Bind ViewModel.HasAnyItems, Mode=OneWay}"/>
                <Button Content="Split PDF" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind ViewModel.IsSplit, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SplitPdfCommand}" IsEnabled="{x:Bind ViewModel.HasAnyItems, Mode=OneWay}"/>
                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
                <Button Content="Output folder…" Command="{x:Bind ViewModel.ChooseOutputFolderCommand}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}" Opacity="0.55" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>

        <StackPanel Grid.Row="7" Spacing="4">
            <ProgressBar Value="{x:Bind ViewModel.Status.Progress, Mode=OneWay}" Maximum="100"/>
            <TextBlock Text="{x:Bind ViewModel.Status.StatusMessage, Mode=OneWay}" Opacity="0.7" FontSize="12"/>
        </StackPanel>

        <TextBlock Grid.Row="8" Text="{x:Bind ViewModel.FooterNote, Mode=OneWay}" Opacity="0.45" FontSize="12"/>
    </Grid>
</UserControl>
