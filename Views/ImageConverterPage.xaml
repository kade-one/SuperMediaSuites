<UserControl
    x:Name="Root"
    x:Class="SuperMediaSuites.Views.ImageConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SuperMediaSuites.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="780" d:DesignWidth="940"
    FontFamily="Trebuchet MS">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#6C5CE7" Opacity="0.5"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#6C5CE7" Opacity="0.55"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <!-- Per-tab accent: Image (indigo) -->
        <Color x:Key="SystemAccentColor">#6C5CE7</Color>
        <Color x:Key="SystemAccentColorLight1">#6C5CE7</Color>
        <Color x:Key="SystemAccentColorLight2">#6C5CE7</Color>
        <Color x:Key="SystemAccentColorLight3">#6C5CE7</Color>
        <Color x:Key="SystemAccentColorDark1">#5749C3</Color>
        <Color x:Key="SystemAccentColorDark2">#463AA0</Color>
        <Color x:Key="SystemAccentColorDark3">#382E7E</Color>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Padding="28,20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Image Converter" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="jpg · png · webp · bmp · gif · tiff · heic · avif · ico" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="18">
                <TextBlock Text="Drag &amp; drop image files here, or use Add files" Opacity="0.55"/>
            </Border>
            <Button Grid.Column="1" Content="Add files" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddFilesCommand}"/>
            <Button Grid.Column="2" Content="Clear" Command="{x:Bind ViewModel.ClearAllCommand}"/>
        </Grid>

        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="6" Padding="6">
            <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConversionItem">
                        <Grid ColumnSpacing="10" Padding="6" AutomationProperties.Name="{x:Bind FileName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Opacity="0.65" FontSize="12"/>
                            </StackPanel>
                            <ProgressBar Grid.Column="1" Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" VerticalAlignment="Center"
                                    Click="OnRemoveItemClick"
                                    Content="✕" Padding="8,4"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16" Padding="0,4">
            <StackPanel Spacing="2">
                <TextBlock Text="Output format" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.OutputFormats, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.TargetFormat, Mode=TwoWay}" MinWidth="120"/>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="Resize" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableResizeModes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.ResizeMode, Mode=TwoWay}" MinWidth="150"/>
            </StackPanel>
            <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.IsResizeScale, Mode=OneWay}">
                <TextBlock Text="Scale %" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Slider Minimum="10" Maximum="400" Value="{x:Bind ViewModel.ScalePercent, Mode=TwoWay}" Width="160"/>
                    <TextBlock Text="{x:Bind ViewModel.ScalePercent, Mode=OneWay}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.IsResizeDimensions, Mode=OneWay}">
                <TextBlock Text="Width × Height" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Text="{x:Bind ViewModel.TargetWidth, Mode=TwoWay}" Width="70" Header=""/>
                    <TextBlock Text="×" VerticalAlignment="Center"/>
                    <TextBox Text="{x:Bind ViewModel.TargetHeight, Mode=TwoWay}" Width="70"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="20">
            <StackPanel Spacing="2">
                <TextBlock Text="Quality (1–100)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Slider Minimum="1" Maximum="100" Value="{x:Bind ViewModel.Quality, Mode=TwoWay}" Width="160"/>
                    <TextBlock Text="{x:Bind ViewModel.Quality, Mode=OneWay}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="Background (for JPG)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <TextBox Text="{x:Bind ViewModel.BackgroundColor, Mode=TwoWay}" Width="100"/>
            </StackPanel>
            <CheckBox Content="Preserve EXIF" IsChecked="{x:Bind ViewModel.PreserveExif, Mode=TwoWay}" VerticalAlignment="Bottom"/>
        </StackPanel>

        <Grid Grid.Row="6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Content="Convert" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ConvertCommand}" IsEnabled="{x:Bind ViewModel.CanConvert, Mode=OneWay}"/>
                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
                <Button Content="Output folder…" Command="{x:Bind ViewModel.ChooseOutputFolderCommand}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}" Opacity="0.55" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>

        <StackPanel Grid.Row="7" Spacing="4">
            <ProgressBar Value="{x:Bind ViewModel.Status.Progress, Mode=OneWay}" Maximum="100"/>
            <TextBlock Text="{x:Bind ViewModel.Status.StatusMessage, Mode=OneWay}" Opacity="0.7" FontSize="12"/>
        </StackPanel>

        <TextBlock Grid.Row="8" Text="{x:Bind ViewModel.FooterNote, Mode=OneWay}" Opacity="0.45" FontSize="12"/>
    </Grid>
</UserControl>
