<UserControl
    x:Class="SuperMediaSuites.Views.CdRipperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SuperMediaSuites.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="760" d:DesignWidth="940"
    FontFamily="Tahoma">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2D9CDB" Opacity="0.5"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2D9CDB" Opacity="0.55"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <!-- Per-tab accent: CD Ripper (sky blue) -->
        <Color x:Key="SystemAccentColor">#2D9CDB</Color>
        <Color x:Key="SystemAccentColorLight1">#2D9CDB</Color>
        <Color x:Key="SystemAccentColorLight2">#2D9CDB</Color>
        <Color x:Key="SystemAccentColorLight3">#2D9CDB</Color>
        <Color x:Key="SystemAccentColorDark1">#1E83BF</Color>
        <Color x:Key="SystemAccentColorDark2">#196B9E</Color>
        <Color x:Key="SystemAccentColorDark3">#14547D</Color>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root" Padding="28,20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="CD Ripper" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Rip audio CDs to FLAC or MP3, with optional MusicBrainz metadata lookup" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Drive" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedDrive, Mode=TwoWay}"
                          DisplayMemberPath="Display" MinWidth="220"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh drives" Command="{x:Bind ViewModel.RefreshDrivesCommand}" VerticalAlignment="Bottom"/>
            <Button Grid.Column="2" Content="Read CD" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.LoadTracksCommand}" VerticalAlignment="Bottom"/>
            <StackPanel Grid.Column="3" Spacing="2">
                <TextBlock Text="Format" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.OutputFormats, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.TargetFormat, Mode=TwoWay}" MinWidth="100"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6" Padding="6">
            <ListView ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CdTrack">
                        <Grid ColumnSpacing="12" Padding="6" AutomationProperties.Name="{x:Bind Title}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Number}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind DurationText, Mode=OneWay}" Opacity="0.6" FontSize="12"/>
                            </StackPanel>
                            <ProgressBar Grid.Column="2" Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind StatusText, Mode=OneWay}" Opacity="0.7" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Content="Rip all tracks" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.RipCommand}" IsEnabled="{x:Bind ViewModel.CanRip, Mode=OneWay}"/>
                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
                <Button Content="Output folder…" Command="{x:Bind ViewModel.ChooseOutputFolderCommand}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}" Opacity="0.55" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>

        <StackPanel Grid.Row="4" Spacing="4">
            <ProgressBar Value="{x:Bind ViewModel.Status.Progress, Mode=OneWay}" Maximum="100"/>
            <TextBlock Text="{x:Bind ViewModel.Status.StatusMessage, Mode=OneWay}" Opacity="0.7" FontSize="12"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Text="{x:Bind ViewModel.FooterNote, Mode=OneWay}" Opacity="0.45" FontSize="12"/>
        <TextBlock Grid.Row="6" Text="Tip: MP3 rips at 320 kbps by default — pick FLAC for lossless, and turn on metadata lookup to name tracks automatically." Opacity="0.4" FontSize="11"/>
    </Grid>
</UserControl>
